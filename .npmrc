# npm install fails outright without this, and has for a while.
#
# Two dependencies declare peers that cannot be satisfied together with the
# React the project actually runs:
#
#   react-bootstrap-table-next@4  asks for react ^16.3.0. It is unmaintained and
#     works fine on React 18; it draws the puzzle picker's table.
#   react-native, reached through @react-three/fiber -> @react-spring/native,
#     asks for react ^19. Nothing here renders native anything; it comes along
#     for the ride and is never imported.
#
# legacy-peer-deps resolves peers the way npm 6 did — install what is asked for
# and do not fail on a peer mismatch — which is how this tree was built in the
# first place. Without it a fresh clone cannot install at all.
legacy-peer-deps=true
