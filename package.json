  },
  "keywords": [
    "react",
    "react-admin",
    "deck-gl",
    "sqlite"
  ],
  "license": "MIT",
  "name": "mappuzzle.gl",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "@react-three/fiber": "^8.16.6",
    "@turf/turf": "^6.5.0",
    "axios": "^1.6.8",
    "bootstrap": "^5.3.3",
    "deck.gl": "^8.9.36",
    "dom-helpers": "^5.2.1",
    "events": "3.3.0",
    "i18next": "^22.5.1",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.2",
    "react-bootstrap-icons": "^1.11.4",
    "react-bootstrap-table-next": "^4.0.3",
    "react-bootstrap-table2-paginator": "^2.1.2",
    "react-dom": "^18.3.1",
    "react-easyfullscreen": "^1.1.2",
    "react-i18next": "^12.3.1",
    "react-map-gl": "5.3.21",
    "react-markdown": "^6.0.2",
    "react-query": "^3.39.3",
    "react-responsive": "^9.0.2",
    "react-router-dom": "^6.23.1",
    "react-share": "^5.1.0",
    "react-simple-cookie-store": "^1.0.12",
    "react-spring": "9.7.3",
    "sql.js": "^1.10.3",
    "sql.js-httpvfs": "^0.8.12",
    "three": "^0.164.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --config apps/game/vite.config.ts",
    "dev-php-backend": "vite --config apps/game/vite.config.ts --mode devphpbackend",
    "editor": "vite --config apps/editor/vite.config.ts",
    "backend": "npm --prefix apps/backend run dev",
    "build": "vite build --config apps/game/vite.config.ts --mode phpbackend && node --no-warnings scripts/prerender.mjs",
    "preview": "vite preview --config apps/game/vite.config.ts --port 3000 --strictPort",
    "typecheck": "npm run typecheck:game && npm run typecheck:editor && npm run typecheck:backend",
    "typecheck:game": "tsc -p apps/game/tsconfig.json",
    "typecheck:editor": "tsc -p apps/editor/tsconfig.json",
    "typecheck:backend": "tsc -p apps/backend/tsconfig.build.json --noEmit",
    "publish-db": "node scripts/publish-db.mjs",
    "deploy": "node scripts/deploy.mjs",
    "deploy:app": "node scripts/deploy.mjs --only=app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^15.14.0",
    "@types/react": "^18.3.2",
    "@types/react-bootstrap-table-next": "^4.0.26",
    "@types/react-bootstrap-table2-paginator": "^2.1.5",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.1.7",
    "@types/sql.js": "^1.4.9",
    "@types/three": "^0.164.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.3.1",
    "basic-ftp": "^6.2.0",
    "eslint": "^7.9.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.34.1",
    "http-server": "^14.1.1",
    "sass": "^1.93.3",
    "typescript": "^5.4.5",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^0.21.2",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
