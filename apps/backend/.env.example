# Copy to .env. That file is gitignored: it was not, and it carried a secret.
#
# Only the editor's backend reads any of this, and only on your machine —
# production is static files plus the read-only PHP gateway, with no Node at
# all. So there is nothing here that a server needs to know.

# Where the authoring database lives. scripts/publish-db.mjs copies this one
# over data/front.sqlite3.png, which is what the game reads.
SQLITE_PATH=./db/backend.sqlite3.png

# The port the editor talks to. The game's development environment expects 5000.
PORT=5000

NODE_ENV=development

# Optional, all defaulting to the repository's own layout. Set them when the
# content lives somewhere else, for example on another drive.
# ASSETS_DIR=../../data
# TEMP_DIR=../../temp
# SHAPEFILES_DIR=../../data/shapefiles
