# Copy to .env.deploy and fill in. .env.deploy is gitignored: this repository is
# public, so credentials must never be committed.
#
# Plain FTP sends the password in the clear. Set FTP_SECURE=true if the hosting
# accepts FTPS on the same port; it is worth checking.

FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false

# Directory the site is served from. Some hosts drop the FTP login straight into
# it, in which case use "." — the script prints where it landed.
FTP_REMOTE_DIR=/public_html
